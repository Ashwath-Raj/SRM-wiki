# Server & Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
SECRET_KEY=dev-secret-key-change-in-production-srm-wiki-2026
ADMIN_TOKEN=srmwiki-admin-secret-token-2026
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (defaults to SQLite for frictionless local execution, or PostgreSQL with pgvector)
DATABASE_URL=sqlite:///./srm_wiki.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/srmwiki

# AI Provider (mock, openai, gemini)
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Crawler Configuration
CRAWLER_USER_AGENT=SRMAPWikiBot/1.0 (+https://wiki.srmap.edu.in/bot)
CRAWLER_RATE_LIMIT_DELAY=1.0
CRAWLER_MAX_DEPTH=2

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
